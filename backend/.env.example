# Copy to .env and adjust. Used by the app (pydantic-settings) and by docker compose
# (port variables). Inside compose the api service overrides DATABASE_URL/REDIS_URL.

# --- docker compose host ports ---
DB_PORT=5432
REDIS_PORT=6379
API_PORT=8000
PROMETHEUS_PORT=9090
LOKI_PORT=3100
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=atlas-demo-change-me
METRICS_REFRESH_SECONDS=300

# --- app ---
ENVIRONMENT=dev
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+asyncpg://atlas:atlas@localhost:5432/atlas
# Empty value disables Redis (in-process cache is used instead).
REDIS_URL=redis://localhost:6379/0

# Index model owned by ML: YAML config + engine implementation.
MODEL_CONFIG_PATH=config/model.default.yaml
SCORING_ENGINE=app.scoring.reference:ReferenceIndexEngine
DEFAULT_PRESET=family

# ML outputs (parquet) — repository ../data by default.
# DATA_DIR=../data

# Ambulance travel times (python -m app.cli load-ambulance): model parameters, the ML road graph
# (Git LFS) and the SRTM elevation tiles committed in data/srtm (3″). fetch-srtm adds missing tiles:
# it downloads 1″ tiles from SRTM_URL and stores them at SRTM_ARCSEC (3 = averaged to 3″).
# AMBULANCE_CONFIG_PATH=config/ambulance.default.yaml
# GRAPH_DIR=../graph
# SRTM_DIR=data/srtm
# SRTM_ARCSEC=3
# SRTM_URL=https://elevation-tiles-prod.s3.amazonaws.com/skadi/{folder}/{name}.hgt.gz

# OSRM (owned by MLOps). Empty = what-if uses the analytical method only.
OSRM_CAR_URL=
OSRM_FOOT_URL=

# Chat assistant (feature #2) on Anthropic Claude. Without a key /chat degrades gracefully.
CHAT_ENABLED=true
# API key from platform.claude.com (Console -> API keys). Never commit it.
ANTHROPIC_API_KEY=
# claude-sonnet-5-5 (default) | claude-haiku-5-5 (faster, cheaper) | claude-opus-5-5 (strongest)
LLM_MODEL=claude-sonnet-5-5
# low | medium | high | xhigh | max: thinking depth and token spend
LLM_EFFORT=medium
# Server-side refusal fallback; sent only to models that support it (not Haiku).
LLM_FALLBACKS=true
# LLM_MAX_TOKENS=16000
# LLM_TIMEOUT_S=90
# LLM_MAX_RETRIES=2
EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDINGS_OFFLINE=true

# Limits (per client IP). Behind the Next.js proxy / nginx set TRUST_FORWARDED_FOR=true.
TRUST_FORWARDED_FOR=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_WHATIF_PER_MINUTE=30
RATE_LIMIT_CHAT_PER_MINUTE=12
