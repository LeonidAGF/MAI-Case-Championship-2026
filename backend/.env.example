# Copy to .env and adjust: the API's settings (pydantic-settings). docker-compose.yml in the repository
# root passes this file to the api container and overrides DATABASE_URL, REDIS_URL, the data folders and
# the proxy and CORS settings. Ports, passwords and the site login of the compose stack are in the root .env.

# --- app ---
METRICS_REFRESH_SECONDS=300
ENVIRONMENT=dev
LOG_LEVEL=INFO
# Browser origins allowed to call the API (CORS), comma-separated. Used when the API runs without
# Docker; in Docker CORS_ORIGINS comes from the root .env.
CORS_ORIGINS=https://cson.ru,http://localhost:3000
DATABASE_URL=postgresql+asyncpg://atlas:atlas@localhost:5432/atlas
# Empty value disables Redis (in-process cache is used instead).
REDIS_URL=redis://localhost:6379/0

# Index model owned by ML: YAML config + engine implementation.
MODEL_CONFIG_PATH=config/model.default.yaml
SCORING_ENGINE=app.scoring.reference:ReferenceIndexEngine
DEFAULT_PRESET=family

# ML outputs (parquet) — repository ../data by default.
# DATA_DIR=../data

# Ambulance travel times (python -m app.cli load-ambulance): model parameters, the ML road graph
# (Git LFS) and the SRTM elevation tiles committed in data/srtm (3″). fetch-srtm adds missing tiles:
# it downloads 1″ tiles from SRTM_URL and stores them at SRTM_ARCSEC (3 = averaged to 3″).
# AMBULANCE_CONFIG_PATH=config/ambulance.default.yaml
# GRAPH_DIR=../graph
# SRTM_DIR=data/srtm
# SRTM_ARCSEC=3
# SRTM_URL=https://elevation-tiles-prod.s3.amazonaws.com/skadi/{folder}/{name}.hgt.gz

# OSRM (owned by MLOps). Empty = what-if uses the analytical method only.
OSRM_CAR_URL=
OSRM_FOOT_URL=

# Chat assistant (feature #2) on Anthropic Claude. Without a key /chat degrades gracefully.
CHAT_ENABLED=true
# API key from platform.claude.com (Console -> API keys). Never commit it.
ANTHROPIC_API_KEY=
# claude-sonnet-5-5 (default) | claude-haiku-5-5 (faster, cheaper) | claude-opus-5-5 (strongest)
LLM_MODEL=claude-sonnet-5-5
# low | medium | high | xhigh | max: thinking depth and token spend
LLM_EFFORT=medium
# Server-side refusal fallback; sent only to models that support it (not Haiku).
LLM_FALLBACKS=true
# LLM_MAX_TOKENS=16000
# LLM_TIMEOUT_S=90
# LLM_MAX_RETRIES=2
# HTTP proxy for the chat's Anthropic client only. Empty = direct. In Docker it comes from the root .env
# (http://vpn-egress:8888 with COMPOSE_PROFILES=vpn, or http://xray-egress:8888 with COMPOSE_PROFILES=xray),
# not from this file.
# LLM_PROXY_URL=
EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDINGS_OFFLINE=true

# Limits (per client IP). Behind a proxy set TRUST_FORWARDED_FOR=true (docker-compose.yml does: Caddy).
TRUST_FORWARDED_FOR=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_WHATIF_PER_MINUTE=30
RATE_LIMIT_CHAT_PER_MINUTE=12
# /v1 data API for organisations: requests per minute per API key.
RATE_LIMIT_API_KEY_PER_MINUTE=120
# Public address of this API, used in the letters printed by key-issue.
API_PUBLIC_URL=http://localhost:8000

# Payment details printed in the invoice letters of order-create (one line), e.g. bank account and recipient.
# Payments are confirmed by hand: python -m app.cli order-confirm <order> --received <amount>.
PAYMENT_DETAILS=
