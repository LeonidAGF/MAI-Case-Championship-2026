# Copy to .env and adjust. Used by the app (pydantic-settings) and by docker compose
# (port variables). Inside compose the api service overrides DATABASE_URL/REDIS_URL.

# --- docker compose host ports ---
DB_PORT=5432
REDIS_PORT=6379
API_PORT=8000
PROMETHEUS_PORT=9090
LOKI_PORT=3100
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=atlas-demo-change-me
METRICS_REFRESH_SECONDS=300

# --- app ---
ENVIRONMENT=dev
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+asyncpg://atlas:atlas@localhost:5432/atlas
# Empty value disables Redis (in-process cache is used instead).
REDIS_URL=redis://localhost:6379/0

# Index model owned by ML: YAML config + engine implementation.
MODEL_CONFIG_PATH=config/model.default.yaml
SCORING_ENGINE=app.scoring.reference:ReferenceIndexEngine
DEFAULT_PRESET=family

# ML outputs (parquet) — repository ../data by default.
# DATA_DIR=../data

# OSRM (owned by MLOps). Empty = what-if uses the analytical method only.
OSRM_CAR_URL=
OSRM_FOOT_URL=

# Chat assistant (feature #2). Without credentials /chat degrades gracefully.
CHAT_ENABLED=true
# GigaChat authorization key = base64(client_id:client_secret) from developers.sber.ru. Never commit it.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GigaChat-3-Pro | GigaChat-3-Ultra | GigaChat-3-Lightning | GigaChat-2-Max ... (python -m app.cli chat-check lists them)
GIGACHAT_MODEL=GigaChat-3-Pro
# Russian Trusted Root/Sub CA for GigaChat TLS; the repo ships them in config/certs (file or directory).
# GIGACHAT_CA_BUNDLE=config/certs
# GIGACHAT_TEMPERATURE=0.3
# GIGACHAT_MAX_TOKENS=2048
EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDINGS_OFFLINE=true

# Limits (per client IP). Behind the Next.js proxy / nginx set TRUST_FORWARDED_FOR=true.
TRUST_FORWARDED_FOR=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_WHATIF_PER_MINUTE=30
RATE_LIMIT_CHAT_PER_MINUTE=12
