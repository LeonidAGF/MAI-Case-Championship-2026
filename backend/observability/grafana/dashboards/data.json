  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "region",
        "label": "Субъект",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "atlas-prometheus"
        },
        "query": {
          "query": "label_values(atlas_region_feature_coverage_ratio, region)",
          "refId": "A"
        },
        "regex": "",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "feature",
        "label": "Признак",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "atlas-prometheus"
        },
        "query": {
          "query": "label_values(atlas_etl_imputed_feature_values, feature)",
          "refId": "A"
        },
        "regex": "",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
