    {
      "id": 7,
      "title": "Запросы по маршрутам",
      "description": "Маршруты шаблонные: идентификаторы территорий не становятся метками; проверки работоспособности исключены.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "atlas-prometheus"
