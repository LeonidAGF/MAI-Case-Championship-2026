      "datasource": {
        "type": "prometheus",
        "uid": "atlas-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * (sum(rate(atlas_partner_api_requests_total{dataset=~\"$dataset\",format=~\"$format\",region=~\"$region\"}[5m])) or vector(0))",
          "datasource": {
