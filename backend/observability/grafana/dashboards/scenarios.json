{
  "uid": "atlas-scenarios",
  "title": "03 · Сценарии, маршрутизация и журналы",
  "description": "Прогоны what-if, доступность OSRM, аналитические замены и журналы API.",
  "tags": [
    "СКФО",
    "Атлас",
    "наблюдаемость"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Успешные сценарии за час",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "atlas-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(atlas_whatif_runs_total{outcome=\"success\"}[1h])) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "atlas-prometheus"
          },
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      }
    },
