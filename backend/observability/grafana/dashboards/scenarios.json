      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (scenario) (rate(atlas_whatif_affected_territories_sum[1h])) / clamp_min(sum by (scenario) (rate(atlas_whatif_affected_territories_count[1h])), 0.00001)",
