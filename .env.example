# Settings of docker-compose.yml (the whole app). Copy to .env in the repository root and fill in.
# The API's own settings (ANTHROPIC_API_KEY, LLM_MODEL, limits, ...) stay in backend/.env.

# --- site ---
# A domain pointed at this server (e.g. atlas.example.com) gets HTTPS from Let's Encrypt automatically.
# ":80" serves plain HTTP on any address: local runs, or a server without a domain.
SITE_ADDRESS=:80
# Public address of the site, used in the letters printed by key-issue (API_PUBLIC_URL = this + /api).
PUBLIC_URL=http://localhost

# Login for the whole site. Required: Caddy refuses to start without it. Make the hash with
#   docker run --rm caddy:2.11-alpine caddy hash-password --plaintext 'your-password'
# and keep the single quotes around it, because the hash contains "$".
BASIC_AUTH_USER=atlas
BASIC_AUTH_HASH=''

# --- passwords: change both on a server ---
# The database password applies when the database is first created. Use letters and digits only,
# because it goes into a connection URL (e.g. openssl rand -hex 24).
POSTGRES_PASSWORD=atlas
GRAFANA_ADMIN_PASSWORD=atlas-demo-change-me

# --- images ---
# Tag of kekishev/case-championship-backend and kekishev/case-championship-frontend built by CI:
# latest (the last build of main), sha-<commit>, or a release such as 1.2.0.
IMAGE_TAG=latest

# --- chat through the VPN tunnel (optional) ---
# Uncomment both lines and put the AmneziaWG client config at backend/secrets/awg0.conf.
# COMPOSE_PROFILES=vpn
# LLM_PROXY_URL=http://vpn-egress:8888

# --- local ports, bound to 127.0.0.1 only ---
# API_PORT=8000
# DB_PORT=5432
# REDIS_PORT=6379
# PROMETHEUS_PORT=9090
# LOKI_PORT=3100
# GRAFANA_PORT=3001
